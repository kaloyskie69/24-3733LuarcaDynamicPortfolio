<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- Remove the default ASP.NET Membership/Profile connection string (LocalSqlServer) —
         this project uses its own custom authentication, not the built-in Membership system,
         so this default entry is unused and only exists to trigger a misleading
         "requires SQL Server Express" prompt in Visual Studio if left in place. -->
    <remove name="LocalSqlServer" />

    <!--
      Update Data Source to your SQL Server instance name.
      Examples:
        Local default instance:      Data Source=.
        Local named instance:        Data Source=.\SQLEXPRESS
        Remote server:                Data Source=YOUR_SERVER_NAME
      If you use SQL Server Authentication instead of Windows auth, replace
      "Integrated Security=True" with "User Id=YOUR_USER;Password=YOUR_PASSWORD;"
    -->
    <add name="PersonalWebsiteDB"
         connectionString="Data Source=.;Initial Catalog=PersonalWebsiteDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <!-- Classic (non-jQuery) validation scripts, since this project doesn't register
         a ScriptResourceMapping for jquery (Bootstrap's CDN bundle is used instead). -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />

    <!-- Forms Authentication: users are redirected to Login.aspx if not signed in -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx"
             timeout="60"
             slidingExpiration="true"
             protection="All"
             cookieless="UseCookies"
             name=".PWPAUTH" />
    </authentication>

    <authorization>
      <deny users="?" />
      <!-- Anonymous users are denied by default site-wide.
           Login.aspx / Register.aspx explicitly allow anonymous access
           via their own location entries below. -->
    </authorization>

    <sessionState mode="InProc" timeout="60" />
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>

  <!-- Allow anonymous (not-signed-in) access to the login/register/public assets -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Register.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Admin-only folder: only users in the "Admin" role (set in code via IPrincipal) may access -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
