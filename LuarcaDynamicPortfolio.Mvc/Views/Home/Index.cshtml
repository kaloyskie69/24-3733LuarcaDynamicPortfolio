@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Home.DynamicWebsiteViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- Welcome Header -->
<header class="editorial-masthead">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <span class="overline overline-accent">WELCOME</span>
            <h1 class="display-title mb-0">HELLO, @Model.CurrentUserName.ToUpper()!</h1>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit Content
                </a>
            </div>
        }
    </div>
    
    <div class="d-flex flex-wrap justify-content-between align-items-center border-top border-bottom border-dark py-2">
        <span class="caption-text text-uppercase">
            Browse our company information, products, services, and contact details below.
        </span>
    </div>
</header>

<!-- ==================== SECTION A: ABOUT THE BUSINESS / COMPANY ==================== -->
<section id="company" class="mb-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-8">
            <div class="card card-elevated h-100 p-4">
                <span class="overline">ABOUT THE BUSINESS</span>
                <h2 class="headline-title mt-1 mb-2">@Model.Company.CompanyName</h2>
                <p class="body-large fw-semibold text-dark mb-4">@Model.Company.Tagline</p>
                
                <p class="mb-4">@Model.Company.AboutDescription</p>

                @if (!string.IsNullOrEmpty(Model.Company.Mission))
                {
                    <blockquote class="pull-quote">
                        "@Model.Company.Mission"
                        <span class="pull-quote-source">&mdash; Our Mission</span>
                    </blockquote>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="editorial-border-box h-100 d-flex flex-column justify-content-between">
                <div>
                    <span class="overline">OUR VISION</span>
                    <h3 class="subhead-title mt-1 mb-3">LOOKING FORWARD</h3>
                    <p class="body-small mb-4">@Model.Company.Vision</p>
                </div>

                <div class="border-top border-dark pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="caption-text fw-bold text-uppercase">Type</span>
                        <span class="badge bg-primary">Web Solutions</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="caption-text fw-bold text-uppercase">Platform</span>
                        <span class="badge bg-secondary">ASP.NET Core</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== SECTION B: PRODUCTS AND SERVICES ==================== -->
<section id="products-services" class="mb-5">
    <div class="d-flex justify-content-between align-items-end border-bottom border-dark pb-2 mb-4">
        <div>
            <span class="overline overline-accent">WHAT WE OFFER</span>
            <h2 class="headline-title mb-0">PRODUCTS &amp; SERVICES</h2>
        </div>
        <span class="caption-text text-uppercase fw-bold">@Model.ProductsServices.Count Items</span>
    </div>

    <div class="row g-4">
        @if (Model.ProductsServices.Any())
        {
            @foreach (var item in Model.ProductsServices)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="overline mb-0">#@item.DisplayOrder</span>
                                <span class="badge @(item.Category == "Product" ? "bg-warning" : "bg-primary")">
                                    @item.Category
                                </span>
                            </div>

                            <h3 class="subhead-title mt-2 mb-2">@item.Title</h3>
                            <p class="body-small mb-3">@item.Description</p>
                        </div>

                        <div>
                            @if (!string.IsNullOrEmpty(item.Tags))
                            {
                                <div class="mb-3">
                                    @foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="chip mb-1 me-1">@tag.Trim()</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.ActionUrl))
                            {
                                <a href="@item.ActionUrl" target="_blank" class="btn btn-secondary btn-sm w-100">
                                    View Details <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="p-4 border border-dark text-center">
                    <p class="mb-0 text-muted">No products or services listed at this time.</p>
                </div>
            </div>
        }
    </div>
</section>

<!-- ==================== SECTIONS D & C: OWNER & CONTACT ==================== -->
<section class="mb-5">
    <div class="row g-4">
        
        <!-- SECTION D: OWNER'S INFORMATION -->
        <div class="col-lg-7">
            <div class="card p-4 h-100">
                <div class="border-bottom border-dark pb-3 mb-4">
                    <span class="overline overline-accent">MEET THE OWNER</span>
                    <h2 class="headline-title mb-0">OWNER INFORMATION</h2>
                </div>

                <div class="d-flex align-items-center gap-3 mb-4">
                    @{
                        var ownerInitial = !string.IsNullOrWhiteSpace(Model.Owner.FullName) ? Model.Owner.FullName.Trim().Substring(0, 1).ToUpper() : "K";
                    }
                    <div class="author-avatar" style="width: 64px; height: 64px; font-size: 24px; border-width: 3px;">
                        @ownerInitial
                    </div>
                    <div>
                        <h3 class="subhead-title mb-1">@Model.Owner.FullName</h3>
                        <span class="badge bg-primary">@Model.Owner.TitleRole</span>
                    </div>
                </div>

                <div class="mb-4">
                    <span class="overline">ABOUT ME</span>
                    <p class="body-large mb-0">@Model.Owner.Bio</p>
                </div>

                @if (Model.EducationList.Any())
                {
                    <div class="mb-4 pt-3 border-top border-dark">
                        <span class="overline">EDUCATION</span>
                        <div class="mt-2">
                            @foreach (var edu in Model.EducationList)
                            {
                                <div class="mb-2 pb-2 border-bottom border-light">
                                    <div class="fw-bold text-dark text-uppercase">@edu.Level &bull; @edu.SchoolName</div>
                                    @if (!string.IsNullOrEmpty(edu.Course))
                                    {
                                        <div class="caption-text">@edu.Course</div>
                                    }
                                    <div class="caption-text text-muted">@edu.YearFrom &mdash; @edu.YearTo</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.SkillsList.Any())
                {
                    <div class="pt-3 border-top border-dark">
                        <span class="overline">SKILLS</span>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            @foreach (var skill in Model.SkillsList)
                            {
                                <span class="chip">@skill.SkillName</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- SECTION C: CONTACT INFORMATION -->
        <div class="col-lg-5">
            <div class="editorial-border-box h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="border-bottom border-dark pb-3 mb-4">
                        <span class="overline overline-accent">GET IN TOUCH</span>
                        <h2 class="headline-title mb-0">CONTACT INFORMATION</h2>
                    </div>

                    <ul class="list-unstyled mb-4">
                        <li class="py-3 border-bottom border-dark">
                            <span class="overline d-block mb-1">ADDRESS</span>
                            <span class="fw-bold fs-6">@Model.Contact.Address</span>
                        </li>
                        <li class="py-3 border-bottom border-dark">
                            <span class="overline d-block mb-1">PHONE NUMBER</span>
                            <span class="fw-bold fs-6">@Model.Contact.ContactNumber</span>
                        </li>
                        <li class="py-3 border-bottom border-dark">
                            <span class="overline d-block mb-1">EMAIL ADDRESS</span>
                            <span class="fw-bold fs-6 text-break">@Model.Contact.Email</span>
                        </li>
                        <li class="py-3 border-bottom border-dark">
                            <span class="overline d-block mb-1">OFFICE HOURS</span>
                            <span class="fw-bold fs-6">@Model.Contact.OfficeHours</span>
                        </li>
                        @if (!string.IsNullOrEmpty(Model.Contact.SocialLinks))
                        {
                            <li class="py-3">
                                <span class="overline d-block mb-1">LINKS</span>
                                <span class="body-small text-dark fw-semibold">@Model.Contact.SocialLinks</span>
                            </li>
                        }
                    </ul>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Contact.Email))
                {
                    <div class="mt-4 pt-3 border-top border-dark">
                        <a href="mailto:@Model.Contact.Email" class="btn btn-primary w-100 btn-lg">
                            <i class="bi bi-envelope-fill me-1"></i> Send an Email
                        </a>
                    </div>
                }
            </div>
        </div>

    </div>
</section>
