@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Profile.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var passwordModel = ViewBag.PasswordModel as LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Profile.ChangePasswordViewModel ?? new LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Profile.ChangePasswordViewModel();
}

<header class="editorial-masthead">
    <span class="overline overline-accent">ACCOUNT SETTINGS</span>
    <h1 class="headline-title mb-0">MY PROFILE</h1>
    <p class="body-small text-dark mb-0">Update your personal details or change your password.</p>
</header>

<div class="row g-4">
    <!-- User Profile Information -->
    <div class="col-lg-7">
        <div class="card p-4 h-100">
            <div class="border-bottom border-dark pb-3 mb-4 d-flex justify-content-between align-items-center">
                <h2 class="subhead-title mb-0">PERSONAL INFORMATION</h2>
                <span class="badge @(Model.RoleName == "Admin" ? "bg-danger" : "bg-primary")">
                    @Model.RoleName
                </span>
            </div>

            <form asp-controller="Profile" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control" readonly disabled />
                    <span class="caption-text">Username cannot be changed.</span>
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="Your full name" maxlength="150" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" maxlength="150" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="p-3 border border-dark bg-light mb-4">
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <span class="overline d-block mb-1">REGISTERED ON</span>
                            <span class="caption-text fw-bold text-dark">@Model.DateCreated.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="overline d-block mb-1">STATUS</span>
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes <i class="bi bi-check2 ms-1"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Security & Password Modification -->
    <div class="col-lg-5">
        <div class="editorial-border-box h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="border-bottom border-dark pb-3 mb-4">
                    <span class="overline overline-accent">SECURITY</span>
                    <h2 class="subhead-title mb-0">CHANGE PASSWORD</h2>
                </div>

                <partial name="_ChangePasswordPartial" model="passwordModel" />
            </div>

            <div class="border-top border-dark pt-3 mt-4">
                <span class="caption-text text-muted">
                    Your password will be updated immediately.
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
