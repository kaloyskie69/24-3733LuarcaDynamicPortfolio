@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card auth-card shadow-lg p-4" style="max-width: 450px; width: 100%;">
        <div class="card-body">
            <div class="text-center mb-4">
                <span class="section-icon section-icon-slate d-inline-block mb-2 p-3 rounded-circle bg-dark border">
                    <i class="bi bi-shield-lock-fill fs-2 text-primary"></i>
                </span>
                <h3 class="fw-bold mb-1">Sign In</h3>
                <p class="text-muted small">You need to sign in first before you can view this website.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label fw-semibold">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter username or email" autofocus />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me on this browser</label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </div>

                <div class="text-center border-top pt-3 mt-3">
                    <p class="text-muted small mb-0">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold text-decoration-none">
                            Sign up here
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
