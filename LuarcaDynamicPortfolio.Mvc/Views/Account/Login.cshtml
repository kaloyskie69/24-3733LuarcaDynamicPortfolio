@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper d-flex justify-content-center align-items-center">
    <div class="card auth-card p-4 p-md-5" style="max-width: 460px; width: 100%;">
        <div class="border-bottom border-dark pb-3 mb-4 text-center">
            <span class="overline overline-accent">WELCOME BACK</span>
            <h1 class="headline-title mb-1">SIGN IN</h1>
            <p class="body-small mb-0">Please sign in to view the website.</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label">Username or Email</label>
                <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter username or email" maxlength="150" autofocus />
                <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" maxlength="200" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                Sign In <i class="bi bi-arrow-right ms-1"></i>
            </button>

            <div class="text-center pt-3 border-top border-dark">
                <span class="caption-text d-block mb-1">DON'T HAVE AN ACCOUNT?</span>
                <a asp-controller="Account" asp-action="Register" class="fw-bold text-dark text-uppercase small text-decoration-none border-bottom border-dark">
                    Sign up here &rarr;
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
