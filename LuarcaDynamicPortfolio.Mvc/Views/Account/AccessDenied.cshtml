@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center my-5 py-5">
    <div class="mb-4">
        <i class="bi bi-shield-x text-danger display-1"></i>
    </div>
    <h2 class="fw-bold text-danger">Access Denied</h2>
    <p class="lead text-muted">You do not have administrative privileges to access this area.</p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light me-2">
            <i class="bi bi-house"></i> Return to Home
        </a>
        <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-person"></i> View Your Profile
        </a>
    </div>
</div>
