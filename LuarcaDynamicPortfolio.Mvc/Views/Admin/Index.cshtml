@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var activeTab = ViewBag.ActiveTab as string ?? "users";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
    <div>
        <h3 class="page-title mb-1 text-warning">
            <i class="bi bi-speedometer2 me-2"></i> Administrative Control Center
        </h3>
        <p class="page-subtitle text-muted mb-0">
            Manage users, inspect platform analytics, and dynamically modify website content.
        </p>
    </div>
    <div class="mt-2 mt-md-0">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">
            <i class="bi bi-eye me-1"></i> Preview Live Website
        </a>
    </div>
</div>

<!-- Main Nav Tabs -->
<ul class="nav nav-pills mb-4 gap-2 bg-dark p-2 rounded border border-secondary" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "users" ? "active" : "")" id="users-tab" data-bs-toggle="pill" data-bs-target="#tab-users" type="button" role="tab">
            <i class="bi bi-people-fill me-1"></i> User Accounts
            <span class="badge bg-secondary ms-1">@Model.Users.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "stats" ? "active" : "")" id="stats-tab" data-bs-toggle="pill" data-bs-target="#tab-stats" type="button" role="tab">
            <i class="bi bi-graph-up-arrow me-1"></i> Statistic Reports
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab.StartsWith("content") ? "active" : "")" id="content-tab" data-bs-toggle="pill" data-bs-target="#tab-content" type="button" role="tab">
            <i class="bi bi-layout-text-window-reverse me-1"></i> Website Content Editor
        </button>
    </li>
</ul>

<div class="tab-content" id="adminTabsContent">
    
    <!-- ========================================================================= -->
    <!-- TAB 1: USERS MANAGEMENT (Requirements: View-Only info, Remove or Tag Inactive) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab == "users" ? "show active" : "")" id="tab-users" role="tabpanel">
        <div class="card shadow-sm border-secondary">
            <div class="card-header bg-dark d-flex justify-content-between align-items-center">
                <span class="fw-bold">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i> Registered User Directory
                </span>
                <span class="badge bg-info text-dark">View-Only Info & Status Controls</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>#</th>
                                <th>Username</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Date Registered</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Users.Any())
                            {
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td>@u.UserId</td>
                                        <td class="fw-semibold">
                                            <i class="bi bi-person text-muted me-1"></i> @u.Username
                                        </td>
                                        <td>@(string.IsNullOrEmpty(u.FullName) ? "—" : u.FullName)</td>
                                        <td>@u.Email</td>
                                        <td>
                                            <span class="badge @(u.RoleId == 1 ? "bg-warning text-dark" : "bg-secondary")">
                                                @(u.Role?.RoleName ?? (u.RoleId == 1 ? "Admin" : "User"))
                                            </span>
                                        </td>
                                        <td>@u.DateCreated.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                                @(u.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                <!-- Requirement b.ii: Tag as in-active / active -->
                                                <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserId" />
                                                    <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                            title="@(u.IsActive ? "Tag as Inactive" : "Activate User")">
                                                        <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                                        @(u.IsActive ? "Deactivate" : "Activate")
                                                    </button>
                                                </form>

                                                <!-- Requirement b.ii: Remove user -->
                                                <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.UserId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Are you sure you want to permanently remove this user account?');"
                                                            title="Delete User">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted">No users found in database.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 2: STATISTIC REPORTS (Requirement b.iii: can view statistic reports) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab == "stats" ? "show active" : "")" id="tab-stats" role="tabpanel">
        
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-primary shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">Total Users</small>
                    <h2 class="text-primary fw-bold my-1">@Model.TotalUsers</h2>
                    <small class="text-muted">Registered in DB</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-success shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">Active</small>
                    <h2 class="text-success fw-bold my-1">@Model.ActiveUsers</h2>
                    <small class="text-muted">Can sign in</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-danger shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">Inactive</small>
                    <h2 class="text-danger fw-bold my-1">@Model.InactiveUsers</h2>
                    <small class="text-muted">Deactivated</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-warning shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">Admins</small>
                    <h2 class="text-warning fw-bold my-1">@Model.AdminCount</h2>
                    <small class="text-muted">Full privileges</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-info shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">Regular Users</small>
                    <h2 class="text-info fw-bold my-1">@Model.RegularUserCount</h2>
                    <small class="text-muted">Standard accounts</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-2">
                <div class="card bg-dark border-secondary shadow-sm text-center p-3">
                    <small class="text-muted text-uppercase fw-bold">7-Day Signups</small>
                    <h2 class="text-light fw-bold my-1">@Model.SignupsLast7Days</h2>
                    <small class="text-muted">Recent growth</small>
                </div>
            </div>
        </div>

        <!-- Recent Activity Audit Log Table -->
        <div class="card shadow-sm border-secondary">
            <div class="card-header bg-dark d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-clock-history me-2"></i> Recent Platform Activity Log</span>
                <span class="badge bg-secondary">Top 25 Events</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-sm table-hover align-middle mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Timestamp</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>User</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentActivity.Any())
                            {
                                @foreach (var log in Model.RecentActivity)
                                {
                                    <tr>
                                        <td>@log.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <span class="badge bg-dark border border-secondary text-light">@log.ActionType</span>
                                        </td>
                                        <td class="text-secondary small">@log.ActionDetail</td>
                                        <td>@(log.User?.Username ?? "System / Anonymous")</td>
                                        <td><code>@(log.IPAddress ?? "—")</code></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No audit activity logged yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 3: WEBSITE CONTENT EDITOR (Requirement b.iv & Content a, b, c, d) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab.StartsWith("content") ? "show active" : "")" id="tab-content" role="tabpanel">
        
        <div class="accordion" id="contentAccordion">
            
            <!-- SECTION A: ABOUT THE BUSINESS / COMPANY -->
            <div class="accordion-item bg-dark border-secondary mb-3 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingCompany">
                    <button class="accordion-button bg-dark text-light fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCompany" aria-expanded="true">
                        <i class="bi bi-building text-primary me-2"></i> Section A: About the Business / Company
                    </button>
                </h2>
                <div id="collapseCompany" class="accordion-collapse collapse show">
                    <div class="accordion-body p-4">
                        <form asp-controller="Admin" asp-action="UpdateCompany" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CompanyInfoId" value="@Model.Company.CompanyInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Company / Business Name</label>
                                    <input type="text" name="CompanyName" class="form-control" value="@Model.Company.CompanyName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tagline</label>
                                    <input type="text" name="Tagline" class="form-control" value="@Model.Company.Tagline" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">About Description / Overview</label>
                                <textarea name="AboutDescription" class="form-control" rows="3">@Model.Company.AboutDescription</textarea>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Mission Statement</label>
                                    <textarea name="Mission" class="form-control" rows="2">@Model.Company.Mission</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Vision Statement</label>
                                    <textarea name="Vision" class="form-control" rows="2">@Model.Company.Vision</textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i> Save Company Information
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SECTION B: PRODUCTS AND SERVICES -->
            <div class="accordion-item bg-dark border-secondary mb-3 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingProducts">
                    <button class="accordion-button bg-dark text-light fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProducts">
                        <i class="bi bi-grid-3x3-gap-fill text-info me-2"></i> Section B: Products and Services Catalog
                    </button>
                </h2>
                <div id="collapseProducts" class="accordion-collapse collapse">
                    <div class="accordion-body p-4">
                        
                        <!-- Add New Item Form -->
                        <div class="p-3 mb-4 bg-dark border border-secondary rounded">
                            <h6 class="fw-bold text-info mb-3"><i class="bi bi-plus-circle me-1"></i> Add / Edit Product or Service</h6>
                            <form asp-controller="Admin" asp-action="UpsertProductService" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductServiceId" value="0" />

                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-semibold">Title / Name</label>
                                        <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Web Development Service" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-semibold">Category</label>
                                        <select name="Category" class="form-select form-select-sm">
                                            <option value="Service">Service</option>
                                            <option value="Product">Product</option>
                                            <option value="Software Solution">Software Solution</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold">Tech / Category Tags</label>
                                        <input type="text" name="Tags" class="form-control form-control-sm" placeholder="e.g. C#, ASP.NET, SQL" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label small fw-semibold">Description</label>
                                        <input type="text" name="Description" class="form-control form-control-sm" placeholder="Brief summary of offering..." required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small fw-semibold">Display Order</label>
                                        <input type="number" name="DisplayOrder" class="form-control form-control-sm" value="1" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="submit" class="btn btn-info btn-sm w-100 text-dark fw-semibold">
                                            <i class="bi bi-plus-lg me-1"></i> Add Item
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Existing Products and Services List -->
                        <h6 class="fw-bold text-light mb-2">Existing Catalog Items</h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-sm table-hover align-middle mb-0">
                                <thead class="table-secondary">
                                    <tr>
                                        <th>Order</th>
                                        <th>Category</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Tags</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ProductsServices.Any())
                                    {
                                        @foreach (var item in Model.ProductsServices)
                                        {
                                            <tr>
                                                <td>@item.DisplayOrder</td>
                                                <td>
                                                    <span class="badge @(item.Category == "Product" ? "bg-warning text-dark" : "bg-primary")">
                                                        @item.Category
                                                    </span>
                                                </td>
                                                <td class="fw-semibold">@item.Title</td>
                                                <td class="text-secondary small">@item.Description</td>
                                                <td><small class="text-muted">@(item.Tags ?? "—")</small></td>
                                                <td>
                                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                                        @(item.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <form asp-controller="Admin" asp-action="DeleteProductService" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.ProductServiceId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Remove this product/service?');">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-3 text-muted">No products or services listed.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION C: CONTACT INFORMATION -->
            <div class="accordion-item bg-dark border-secondary mb-3 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingContact">
                    <button class="accordion-button bg-dark text-light fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContact">
                        <i class="bi bi-telephone-fill text-warning me-2"></i> Section C: Contact Information
                    </button>
                </h2>
                <div id="collapseContact" class="accordion-collapse collapse">
                    <div class="accordion-body p-4">
                        <form asp-controller="Admin" asp-action="UpdateContact" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ContactInfoId" value="@Model.Contact.ContactInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Physical Address</label>
                                    <input type="text" name="Address" class="form-control" value="@Model.Contact.Address" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Contact Phone Number</label>
                                    <input type="text" name="ContactNumber" class="form-control" value="@Model.Contact.ContactNumber" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Email Address</label>
                                    <input type="email" name="Email" class="form-control" value="@Model.Contact.Email" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Office Hours</label>
                                    <input type="text" name="OfficeHours" class="form-control" value="@Model.Contact.OfficeHours" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Social Media / Channels</label>
                                <input type="text" name="SocialLinks" class="form-control" value="@Model.Contact.SocialLinks" />
                            </div>

                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save me-1"></i> Save Contact Information
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SECTION D: OWNER'S INFORMATION -->
            <div class="accordion-item bg-dark border-secondary mb-3 rounded overflow-hidden">
                <h2 class="accordion-header" id="headingOwner">
                    <button class="accordion-button bg-dark text-light fw-bold collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOwner">
                        <i class="bi bi-person-badge-fill text-success me-2"></i> Section D: Owner's Information
                    </button>
                </h2>
                <div id="collapseOwner" class="accordion-collapse collapse">
                    <div class="accordion-body p-4">
                        <form asp-controller="Admin" asp-action="UpdateOwner" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OwnerInfoId" value="@Model.Owner.OwnerInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Owner Full Name</label>
                                    <input type="text" name="FullName" class="form-control" value="@Model.Owner.FullName" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Professional Role / Title</label>
                                    <input type="text" name="TitleRole" class="form-control" value="@Model.Owner.TitleRole" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Owner Biography</label>
                                <textarea name="Bio" class="form-control" rows="4">@Model.Owner.Bio</textarea>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Profile Image Path</label>
                                <input type="text" name="ProfileImagePath" class="form-control" value="@Model.Owner.ProfileImagePath" />
                            </div>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save me-1"></i> Save Owner's Information
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
