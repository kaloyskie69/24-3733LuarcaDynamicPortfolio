@model LuarcaDynamicPortfolio.Mvc.Models.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var activeTab = ViewBag.ActiveTab as string ?? "users";
}

<header class="editorial-masthead">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-2">
        <div>
            <span class="overline overline-accent">ADMINISTRATION</span>
            <h1 class="headline-title mb-0">ADMIN DASHBOARD</h1>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="bi bi-eye-fill me-1"></i> View Live Site
            </a>
        </div>
    </div>
    <div class="border-top border-bottom border-dark py-2">
        <span class="caption-text text-uppercase fw-bold">
            Signed in as: <strong class="text-danger">@User.Identity?.Name</strong> (Administrator)
        </span>
    </div>
</header>

<!-- Nav Tabs -->
<ul class="nav nav-pills mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "users" ? "active" : "")" id="users-tab" data-bs-toggle="pill" data-bs-target="#tab-users" type="button" role="tab">
            Users (@Model.Users.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab == "stats" ? "active" : "")" id="stats-tab" data-bs-toggle="pill" data-bs-target="#tab-stats" type="button" role="tab">
            Statistics
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(activeTab.StartsWith("content") ? "active" : "")" id="content-tab" data-bs-toggle="pill" data-bs-target="#tab-content" type="button" role="tab">
            Edit Website Content
        </button>
    </li>
</ul>

<div class="tab-content" id="adminTabsContent">
    
    <!-- ========================================================================= -->
    <!-- TAB 1: USERS (Requirements: View-Only info, Remove or Tag Inactive) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab == "users" ? "show active" : "")" id="tab-users" role="tabpanel">
        <div class="card p-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>USER ACCOUNTS</span>
                <span class="caption-text">View-only user list with status controls</span>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Date Registered</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users.Any())
                        {
                            @foreach (var u in Model.Users)
                            {
                                <tr>
                                    <td class="caption-text font-monospace">#@u.UserId</td>
                                    <td class="fw-bold">@u.Username</td>
                                    <td>@(string.IsNullOrEmpty(u.FullName) ? "—" : u.FullName)</td>
                                    <td>@u.Email</td>
                                    <td>
                                        <span class="badge @(u.RoleId == 1 ? "bg-danger" : "bg-secondary")">
                                            @(u.Role?.RoleName ?? (u.RoleId == 1 ? "Admin" : "User"))
                                        </span>
                                    </td>
                                    <td class="caption-text">@u.DateCreated.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">
                                            @(u.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <!-- Toggle Status -->
                                            <form asp-controller="Admin" asp-action="ToggleUserStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-secondary" : "btn-primary")">
                                                    @(u.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>

                                            <!-- Remove User -->
                                            <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@u.UserId" />
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        data-username="@u.Username"
                                                        onclick="return confirm('Are you sure you want to delete user ' + this.getAttribute('data-username') + '?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 2: STATISTICS (Requirement: Can view statistic reports) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab == "stats" ? "show active" : "")" id="tab-stats" role="tabpanel">
        
        <!-- Metric Cards -->
        <div class="row g-3 mb-5">
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box metric-accent">
                    <span class="overline">TOTAL USERS</span>
                    <div class="metric-number">@Model.TotalUsers</div>
                    <span class="caption-text">All accounts</span>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box">
                    <span class="overline">ACTIVE</span>
                    <div class="metric-number text-success">@Model.ActiveUsers</div>
                    <span class="caption-text">Can log in</span>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box">
                    <span class="overline">INACTIVE</span>
                    <div class="metric-number text-danger">@Model.InactiveUsers</div>
                    <span class="caption-text">Disabled</span>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box">
                    <span class="overline">ADMINS</span>
                    <div class="metric-number">@Model.AdminCount</div>
                    <span class="caption-text">Full access</span>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box">
                    <span class="overline">REGULAR USERS</span>
                    <div class="metric-number">@Model.RegularUserCount</div>
                    <span class="caption-text">Standard</span>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="stat-metric-box">
                    <span class="overline">NEW (7 DAYS)</span>
                    <div class="metric-number">@Model.SignupsLast7Days</div>
                    <span class="caption-text">Recent signups</span>
                </div>
            </div>
        </div>

        <!-- Recent Activity Log Table -->
        <div class="card p-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>RECENT ACTIVITY LOG</span>
                <span class="caption-text">Latest 25 actions</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Date &amp; Time</th>
                            <th>Action</th>
                            <th>Details</th>
                            <th>User</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentActivity.Any())
                        {
                            @foreach (var log in Model.RecentActivity)
                            {
                                <tr>
                                    <td class="caption-text font-monospace">@log.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><span class="chip">@log.ActionType</span></td>
                                    <td class="body-small text-dark">@log.ActionDetail</td>
                                    <td class="fw-bold">@(log.User?.Username ?? "System / Anonymous")</td>
                                    <td><code>@(log.IPAddress ?? "—")</code></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No activity logged yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- TAB 3: WEBSITE CONTENT EDITOR (Requirements: Content a, b, c, d) -->
    <!-- ========================================================================= -->
    <div class="tab-pane fade @(activeTab.StartsWith("content") ? "show active" : "")" id="tab-content" role="tabpanel">
        
        <div class="accordion" id="contentAccordion">
            
            <!-- SECTION A: ABOUT THE BUSINESS / COMPANY -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingCompany">
                    <button class="accordion-button @(activeTab == "content-company" || activeTab == "content" ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCompany" aria-expanded="@(activeTab == "content-company" || activeTab == "content" ? "true" : "false")">
                        A. ABOUT THE BUSINESS / COMPANY
                    </button>
                </h2>
                <div id="collapseCompany" class="accordion-collapse collapse @(activeTab == "content-company" || activeTab == "content" ? "show" : "")">
                    <div class="accordion-body">
                        <form asp-controller="Admin" asp-action="UpdateCompany" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CompanyInfoId" value="@Model.Company.CompanyInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Company Name</label>
                                    <input type="text" name="CompanyName" class="form-control" value="@Model.Company.CompanyName" maxlength="150" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Tagline</label>
                                    <input type="text" name="Tagline" class="form-control" value="@Model.Company.Tagline" maxlength="250" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">About Description</label>
                                <textarea name="AboutDescription" class="form-control" rows="3" maxlength="4000">@Model.Company.AboutDescription</textarea>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label">Mission</label>
                                    <textarea name="Mission" class="form-control" rows="2" maxlength="2000">@Model.Company.Mission</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Vision</label>
                                    <textarea name="Vision" class="form-control" rows="2" maxlength="2000">@Model.Company.Vision</textarea>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Company Info <i class="bi bi-save ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SECTION B: PRODUCTS AND SERVICES -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingProducts">
                    <button class="accordion-button @(activeTab == "content-products" ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProducts" aria-expanded="@(activeTab == "content-products" ? "true" : "false")">
                        B. PRODUCTS AND SERVICES
                    </button>
                </h2>
                <div id="collapseProducts" class="accordion-collapse collapse @(activeTab == "content-products" ? "show" : "")">
                    <div class="accordion-body">
                        
                        <!-- Add New Item Form -->
                        <div class="p-4 border border-dark bg-white mb-4">
                            <span class="overline overline-accent">ADD PRODUCT OR SERVICE</span>
                            <form asp-controller="Admin" asp-action="UpsertProductService" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ProductServiceId" value="0" />

                                <div class="row g-3 mb-3">
                                    <div class="col-md-5">
                                        <label class="form-label">Title / Name</label>
                                        <input type="text" name="Title" class="form-control" placeholder="e.g. Web Development" maxlength="150" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Category</label>
                                        <select name="Category" class="form-select">
                                            <option value="Service">Service</option>
                                            <option value="Product">Product</option>
                                            <option value="Project">Project</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Tags (Comma Separated)</label>
                                        <input type="text" name="Tags" class="form-control" placeholder="e.g. C#, ASP.NET, SQL" maxlength="300" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label">Description</label>
                                        <input type="text" name="Description" class="form-control" placeholder="Brief description..." maxlength="500" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Display Order</label>
                                        <input type="number" name="DisplayOrder" class="form-control" value="1" min="0" max="9999" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button type="submit" class="btn btn-primary w-100">
                                            Add Item
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Existing Items Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Category</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th>Tags</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ProductsServices.Any())
                                    {
                                        @foreach (var item in Model.ProductsServices)
                                        {
                                            <tr>
                                                <td class="caption-text">#@item.DisplayOrder</td>
                                                <td>
                                                    <span class="badge @(item.Category == "Product" ? "bg-warning" : "bg-primary")">
                                                        @item.Category
                                                    </span>
                                                </td>
                                                <td class="fw-bold">@item.Title</td>
                                                <td class="body-small">@item.Description</td>
                                                <td><span class="caption-text">@(item.Tags ?? "—")</span></td>
                                                <td>
                                                    <span class="badge @(item.IsActive ? "bg-success" : "bg-danger")">
                                                        @(item.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <form asp-controller="Admin" asp-action="DeleteProductService" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.ProductServiceId" />
                                                        <button type="submit" class="btn btn-sm btn-danger"
                                                                data-title="@item.Title"
                                                                onclick="return confirm('Remove ' + this.getAttribute('data-title') + '?');">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-3 text-muted">No items found.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION C: CONTACT INFORMATION -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingContact">
                    <button class="accordion-button @(activeTab == "content-contact" ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapseContact" aria-expanded="@(activeTab == "content-contact" ? "true" : "false")">
                        C. CONTACT INFORMATION
                    </button>
                </h2>
                <div id="collapseContact" class="accordion-collapse collapse @(activeTab == "content-contact" ? "show" : "")">
                    <div class="accordion-body">
                        <form asp-controller="Admin" asp-action="UpdateContact" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ContactInfoId" value="@Model.Contact.ContactInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Address</label>
                                    <input type="text" name="Address" class="form-control" value="@Model.Contact.Address" maxlength="300" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone Number</label>
                                    <input type="text" name="ContactNumber" class="form-control" value="@Model.Contact.ContactNumber" maxlength="50" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Email Address</label>
                                    <input type="email" name="Email" class="form-control" value="@Model.Contact.Email" maxlength="150" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Office Hours</label>
                                    <input type="text" name="OfficeHours" class="form-control" value="@Model.Contact.OfficeHours" maxlength="150" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Links (Social Media / Website)</label>
                                <input type="text" name="SocialLinks" class="form-control" value="@Model.Contact.SocialLinks" maxlength="300" />
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Contact Info <i class="bi bi-save ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- SECTION D: OWNER'S INFORMATION -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingOwner">
                    <button class="accordion-button @(activeTab == "content-owner" ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOwner" aria-expanded="@(activeTab == "content-owner" ? "true" : "false")">
                        D. OWNER'S INFORMATION
                    </button>
                </h2>
                <div id="collapseOwner" class="accordion-collapse collapse @(activeTab == "content-owner" ? "show" : "")">
                    <div class="accordion-body">
                        <form asp-controller="Admin" asp-action="UpdateOwner" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="OwnerInfoId" value="@Model.Owner.OwnerInfoId" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Full Name</label>
                                    <input type="text" name="FullName" class="form-control" value="@Model.Owner.FullName" maxlength="150" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Title / Role</label>
                                    <input type="text" name="TitleRole" class="form-control" value="@Model.Owner.TitleRole" maxlength="150" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Biography</label>
                                <textarea name="Bio" class="form-control" rows="4" maxlength="4000">@Model.Owner.Bio</textarea>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Profile Image Path</label>
                                <input type="text" name="ProfileImagePath" class="form-control" value="@Model.Owner.ProfileImagePath" maxlength="300" />
                            </div>

                            <button type="submit" class="btn btn-primary">
                                Save Owner Info <i class="bi bi-save ms-1"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
